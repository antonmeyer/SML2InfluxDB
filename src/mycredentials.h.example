// Copy to src/mycredentials.h (not in git) and fill in. Used by myInfluxdb.h, myOTA.h and myWebConf.h.
#ifndef _mycred
#define _mycred 1

// WLAN. Only used by the test board build (-DTEST_BOARD=1); the real device gets its WLAN from the
// config portal of IotWebConf.
static const char *const ssid = "your WLAN";
static const char *const password = "your password";

// InfluxDB v2: URL, organization (name or id: UI -> User -> About -> Common Ids), API token with write access
#define INFLUXDB_URL "https://eu-central-1-1.aws.cloud2.influxdata.com"
#define INFLUXDB_ORG "your org"
#define INFLUXDB_TOKEN "your token"

// Password of the access point / config portal of an unconfigured device (IotWebConf, min. 8 characters).
// Login of the portal: user "admin" and the AP password.
static const char wifiInitialApPassword[] = "choose a password";

// OTAdrive product keys. Which one is used is chosen at build time:
//   default                        -> OTAKEY_TEST    (test product, Wemos test board)
//   -DOTA_PRODUCT_EMONVH           -> OTAKEY_EMONVH  (product of the real device)
// e.g.  PLATFORMIO_BUILD_FLAGS='-DOTA_PRODUCT_EMONVH' pio run
#define OTAKEY_EMONVH "00000000-0000-0000-0000-000000000000"
#define OTAKEY_TEST "00000000-0000-0000-0000-000000000000"
#ifdef OTA_PRODUCT_EMONVH
#define OTAKEY OTAKEY_EMONVH
#else
#define OTAKEY OTAKEY_TEST
#endif

#endif
